# ==============================================================================
# xSocial Web Client Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local before running the Next.js development server:
#   cp .env.example .env.local
# ==============================================================================

# Public API Gateway Base URL pointing to the xSocial Go backend
# In local development: http://localhost:5000
# In production: https://api.xsocial.io
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

